{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genealogy Tech Watch catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "url"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "legal_notes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "jurisdiction",
            "label",
            "text",
            "checked_at",
            "sources",
            "project_basis"
          ],
          "properties": {
            "id": {
              "enum": [
                "publication",
                "external_processing",
                "genetic_data",
                "archive_access"
              ]
            },
            "jurisdiction": {
              "const": "RU"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "checked_at": {
              "type": "string",
              "format": "date"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "url"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            },
            "project_basis": {
              "type": "object",
              "required": [
                "field",
                "value"
              ],
              "properties": {
                "field": {
                  "const": "description"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "classification": {
        "type": "object",
        "required": [
          "primary_type",
          "domains",
          "origin",
          "sources",
          "reason"
        ],
        "properties": {
          "primary_type": {
            "enum": [
              "application",
              "library",
              "ocr_model",
              "general_model",
              "dataset",
              "standard",
              "adapter",
              "service",
              "prototype",
              "developer_tool",
              "reference",
              "unknown"
            ]
          },
          "domains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "ocr",
                "annotation",
                "archives",
                "images",
                "indexing",
                "gedcom",
                "agents",
                "evidence",
                "linkage",
                "places",
                "trees",
                "genetics",
                "evaluation"
              ]
            }
          },
          "origin": {
            "enum": [
              "initial",
              "watch",
              "manual",
              "unknown"
            ]
          },
          "sources": {
            "type": "array"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "assessment_currency": {
        "type": "object",
        "required": [
          "status",
          "reason",
          "assessment_approved_at",
          "last_substantive_source_check"
        ],
        "properties": {
          "status": {
            "enum": [
              "current",
              "reassess",
              "insufficient",
              "proposed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "additionalProperties": true
  }
}
